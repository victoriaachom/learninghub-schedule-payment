{
  "realm": "learninghub",
  "displayName": "LearningHub",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 1800,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@learninghub.edu",
    "fromDisplayName": "LearningHub",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {"name": "offline_access", "description": "Offline access (built-in)"},
      {"name": "uma_authorization", "description": "UMA authorization (built-in)"},
      {
        "name": "admin",
        "description": "Runs the school: all data, admin writes"
      },
      {
        "name": "teacher",
        "description": "Teaches classes"
      },
      {
        "name": "student",
        "description": "Enrols, learns, pays tuition"
      },
      {
        "name": "default-roles-learninghub",
        "description": "Given to every new user, so self-registered users are students",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "student"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-learninghub",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "learninghub-web",
      "name": "LearningHub web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect"
    }
  ],
